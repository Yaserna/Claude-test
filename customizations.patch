+    // [mod] manual single-message bubble translation
+    private final HashMap<Long, HashSet<Integer>> manualTranslatedMessages = new HashMap<>();
+
+    public boolean isMessageManuallyTranslated(long dialogId, int messageId) {
+        HashSet<Integer> set = manualTranslatedMessages.get(dialogId);
+        return set != null && set.contains(messageId);
+    }
+
+    public boolean isMessageManuallyTranslated(MessageObject messageObject) {
+        return messageObject != null && messageObject.messageOwner != null && isMessageManuallyTranslated(messageObject.getDialogId(), messageObject.getId());
+    }
+
+    public void toggleManualMessageTranslation(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null) {
+            return;
+        }
+        final long dialogId = messageObject.getDialogId();
+        HashSet<Integer> set = manualTranslatedMessages.get(dialogId);
+        if (set == null) {
+            manualTranslatedMessages.put(dialogId, set = new HashSet<>());
+        }
+        final int messageId = messageObject.getId();
+        if (set.contains(messageId) && messageObject.translated) {
+            set.remove(messageId);
+            NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.messageTranslated, messageObject, false);
+            return;
+        }
+        set.add(messageId);
+        final String language = getDialogTranslateTo(dialogId);
+        final TLRPC.TL_textWithEntities existing = messageObject.messageOwner.voiceTranscriptionOpen ? messageObject.messageOwner.translatedVoiceTranscription : messageObject.messageOwner.translatedText;
+        if (existing != null && language.equals(messageObject.messageOwner.translatedToLanguage)) {
+            NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.messageTranslated, messageObject, false);
+            return;
+        }
+        NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.messageTranslating, messageObject);
+        final MessageObject finalMessageObject = messageObject;
+        pushToTranslate(finalMessageObject, language, (isTranscription, id, text, lang) -> {
+            finalMessageObject.messageOwner.translatedToLanguage = lang;
+            if (isTranscription) {
+                finalMessageObject.messageOwner.translatedVoiceTranscription = text;
+            } else {
+                finalMessageObject.messageOwner.translatedText = text;
+            }
+            getMessagesStorage().updateMessageCustomParams(dialogId, finalMessageObject.messageOwner);
+            NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.messageTranslated, finalMessageObject, false);
+        });
+    }
+
     public void toggleTranslatingDialog(long dialogId) {
         toggleTranslatingDialog(dialogId, !isTranslatingDialog(dialogId));
     }
