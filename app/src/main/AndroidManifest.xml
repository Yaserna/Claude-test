<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── مجوزها ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- برای دیدن لیست اپ‌های نصب‌شده روی دستگاه (لازم برای کلون‌سازی) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- برای نصب کلون از فایل APK انتخابی توسط کاربر -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- سرویس پیش‌زمینه که موتور برای زنده نگه‌داشتن پروسه‌های مجازی استفاده می‌کند -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- خواندن APK از حافظه (برای targetSdk 30 و پایین‌تر) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".CloneApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.InfinityClone"
        tools:targetApi="30">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.InstalledAppsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- آیکن‌های صفحه‌ی اصلی این اکتیویتی نامرئی را صدا می‌زنند تا کلون را اجرا کند -->
        <activity
            android:name=".ui.ShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- گرفتن لینک اسکن‌شده از منوی Share و باز کردنش در یک کلون -->
        <activity
            android:name=".ui.LinkRouterActivity"
            android:exported="true"
            android:label="@string/open_in_clone">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- لینک‌های اتصال کیف‌پول (App Link کیف‌پول Acki Nacki / GOSH) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="links.gosh.sh"
                    android:pathPrefix="/deeplinks/wallet" />
                <data android:scheme="http" android:host="links.gosh.sh"
                    android:pathPrefix="/deeplinks/wallet" />
            </intent-filter>
        </activity>

        <!--
            ⚠️ کامپوننت‌های پروکسی موتور (Stub Activities/Services/Providers/:p0..:pN)
            از طریق merge شدن مانیفست AAR موتور اضافه می‌شوند. اگر نسخه‌ی موتور
            نیاز داشته باشد آن‌ها را صریحاً اعلام کنی، طبق مانیفستِ نمونه‌ی موتور
            (ماژول app آن) همین‌جا اضافه کن. جزئیات در README.md.
        -->

    </application>

</manifest>
