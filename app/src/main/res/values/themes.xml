<resources>
    <style name="Theme.PrivateMessages" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="materialAlertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <!-- Symmetric insets so popup menus/dialogs stay centered in RTL (don't drift right). -->
    <style name="AppDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="backgroundInsetStart">24dp</item>
        <item name="backgroundInsetEnd">24dp</item>
    </style>
</resources>
